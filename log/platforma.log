license:
  value: "E-WLGEEFSKFDLSFFQBVWZLGRCBZDEONMVCILLHVQLFDQOTTBOF"
  file: ""

logging:
  level: "info"
  destinations:
    - path: "/storage/log/platforma.log"

monitoring:
  enabled: 
  listen: ""

debug:
  enabled: 
  listen: ""

core:
  grpc:
    listen: "0.0.0.0:6345"

  authEnabled: true
  auth: [ { "driver":"jwt", "key":"DN1iA1cHVhHXQv7v9qhz4Pz5XYrZhZUyA4LI1jU2mPYYvP5mpr2pZHxgN5BfO4xbbJIycI1vEA9OHR2XPpV1SHdYbq0r9B9GkVPWwvVTXoY6YuDbo3uU6Q0NjjS4ouf9kWUmB486UuYxUrGlxbD3pGJZwEmxxI2TmAP575liktphb6Zcyh64pa3UhAYIUMjt9plSxa8F7GP2anjJMUGHeisu0pA5SnMqIEp8q2qs97wYtt8tL16Ikg17dnXxoIZe" }, { "driver":"htpasswd", "path":"/etc/platforma/users.htpasswd" } ]

  logging:
    extendedInfo: true
    dumpResourceData: true

  db:
    path: "/storage/rocksdb"

controllers:
  common:
    timeouts:
      request: 2s
      init: 1m
      stop: 30s

  data:
    main:
      storages:
        primary:
          mode: primary
          downloadable: true

        work:
          mode: active
          downloadable: false

        library:
          mode: passive
          downloadable: false

    storages:
      - id: "primary"
        type: "S3"

        # 'FS' type settings:
        rootPath: "/storage/controllers/data/primary"
        useHardlinks: "auto"

        # 'S3' type settings:
        endpoint: "http://minio:9000/"
        presignEndpoint: "http://localhost:9000/"
        region: "eu-central-1"
        bucketName: "platforma-primary-bucket"
        createBucket: true
        key: "static:testuser"
        secret: "static:testpassword"

        keyPrefix: ""
        accessPrefixes: [ "" ]
        uploadKeyPrefix: ""
        checksumMode: "etag"

      - id: "library"
        type: "FS"

        # 'FS' type settings:
        rootPath: "/storage/controllers/data/library"
        useHardlinks: "auto"

        # 'S3' type settings:
        endpoint: ""
        presignEndpoint: ""
        region: "eu-central-1"
        bucketName: "main-bucket"
        createBucket: true
        key: ""
        secret: ""

        keyPrefix: ""
        accessPrefixes: [ "" ]
        uploadKeyPrefix: ""
        checksumMode: "etag"

      - id: "work"
        type: FS
        indexCachePeriod: "1m"
        rootPath: "/storage/controllers/data/work"
        useHardlinks: "auto"

  runner:
    type: local
    storageRoot: "/storage/controllers/data/work"

  packageLoader:
    packagesRoot: "/storage/controllers/packageLoader"

  workflows: {} # make Workflow Controller to start with default parameters
