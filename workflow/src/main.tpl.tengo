wf := import("@platforma-sdk/workflow-tengo:workflow")

maps := import("@platforma-sdk/workflow-tengo:maps")
ll := import("@platforma-sdk/workflow-tengo:ll")
file := import("@platforma-sdk/workflow-tengo:file")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
metadata := import(":metadata")
assets := import("@platforma-sdk/workflow-tengo:assets")
util := import(":util")
json := import("json")
smart := import("@platforma-sdk/workflow-tengo:smart")
constants := import("@platforma-sdk/workflow-tengo:constants")

prerunTpl := assets.importTemplate(":prerun")

dsFasta := import(":ds-fasta")
dsFastq := import(":ds-fastq")
dsMultilaneFastq := import(":ds-multilane-fastq")
dsTaggedFastq := import(":ds-tagged-fastq")
dsXsv := import(":ds-xsv")
dsTaggedXsv := import(":ds-tagged-xsv")
dsTaggedAb1 := import(":ds-tagged-ab1")
dsCellRangerMtx := import(":ds-cellranger-mtx")
dsBulkCountMatrix := import(":ds-bulk-count-matrix")
dsMultiplexedFastq := import(":ds-multiplexed-fastq")
dsH5ad := import(":ds-h5ad")
dsH5 := import(":ds-h5")
dsSeurat := import(":ds-seurat")
dsMultiSampleH5ad := import(":ds-multisample-h5ad")
dsMultiSampleSeurat := import(":ds-multisample-seurat")
dsMultiSampleXsv := import(":ds-multisample-xsv")

dsProcessors := {
	"Fasta": dsFasta,
	"Fastq": dsFastq,
	"MultilaneFastq": dsMultilaneFastq,
	"TaggedFastq": dsTaggedFastq,
	"Xsv": dsXsv,
	"TaggedXsv": dsTaggedXsv,
	"TaggedAb1": dsTaggedAb1,
	"H5AD": dsH5ad,
	"H5": dsH5,
	"Seurat": dsSeurat,
	"MultiSampleH5AD": dsMultiSampleH5ad,
	"MultiSampleSeurat": dsMultiSampleSeurat,
	"MultiSampleXsv": dsMultiSampleXsv,
	"CellRangerMTX": dsCellRangerMtx,
	"BulkCountMatrix": dsBulkCountMatrix,
	"MultiplexedFastq": dsMultiplexedFastq
}

// Grouped dataset types that export the group-to-sample mapping column
// (`util.sampleGroupsColumn`). MultiplexedFastq maps groups to samples through
// its multiplexing rules instead.
sampleGroupsColumnTypes := {
	"MultiSampleXsv": true
}

wf.setPreRun(prerunTpl)

wf.body(func(args) {
	blockId := wf.blockId().getDataAsJson()

	sampleIdAxis := {
		type: "String",
		name: "pl7.app/sampleId",
		annotations: { "pl7.app/label": "Sample" },
		domain: { "pl7.app/blockId": blockId }
	}

	groupIdAxis := {
		type: "String",
		name: "pl7.app/sampleGroupId",
		annotations: { "pl7.app/label": "Sample Group" },
		domain: { "pl7.app/blockId": blockId }
	}

	exports := pframes.pFrameBuilder()
	
	// Create metadata
	
	for k, v in metadata.createMetadata(args, blockId, sampleIdAxis) {
		exports.add(k, v.spec, v.data)
	}

	// Experiment designs: one JSON value per design, holding its tensors and their STEP 3 labels,
	// derived by the model from the design graph and the metadata. Analysis blocks match a design
	// to an abundance by the sample axis named in pl7.app/design/sampleAxis.
	designExports := {}
	for d in args.designObjects {
		designExports["design." + d.id] = {
			spec: {
				kind: "ExperimentDesign",
				name: "pl7.app/design",
				domain: { "pl7.app/blockId": blockId, "pl7.app/design/designId": d.id },
				// A design has no axes, but the pool is walked as if everything in it were a
				// PColumn: SDK helpers read axesSpec[1] off every spec they find, and an absent
				// list throws before they ever look at the kind.
				axesSpec: [],
				annotations: {
					"pl7.app/label": d.label,
					// the axis the sample ids in `positions` belong to, so a block can find the
					// abundance that covers this design
					"pl7.app/design/sampleAxis": string(json.encode({
						type: sampleIdAxis.type,
						name: sampleIdAxis.name,
						domain: sampleIdAxis.domain
					})),
					"pl7.app/design/samples": string(json.encode(d.samples))
				}
			},
			data: smart.createValueResource(constants.RTYPE_JSON, json.encode(d.data))
		}
	}

	// Create datasets

	fileImports := {}


	// Import file function; avoid re-importing the same file
	importFile := func(importHandle) {
		fromMap := fileImports[importHandle]
		if fromMap == undefined {
			fImport := file.importFile(importHandle)
			fileImports[importHandle] = fImport
			return fImport.file
		} else {
			return fromMap.file
		}
	}

	groupLabels := {}

	for dataset in args.datasets {
		proc := dsProcessors[dataset.content.type]
		if is_undefined(proc) {
			ll.panic("Unknown dataset type %v", dataset.content.type)
		}

		trace := pSpec.makeTrace(undefined,
			{type: "milaboratories.samples-and-data", id: blockId, importance: 10, label: "Samples & Data"},
			{type: "milaboratories.samples-and-data/dataset", id: dataset.id, importance: 100, label: dataset.label}
		)		
		
		ds := undefined 
		if proc.isGrouped {
			datasetGroupIdAxis := proc.createGroupAxis(groupIdAxis, dataset)
			ds = proc.createDataset(blockId, sampleIdAxis, datasetGroupIdAxis, dataset, importFile)

			// Multiplexing rules column (MultiplexedFastq only). Replaces the
			// legacy `pl7.app/sequencing/data/sampleGroups` linker. Returns
			// undefined when the dataset has no rules — no column is emitted.
			if dataset.content.type == "MultiplexedFastq" {
				rules := util.multiplexingRulesColumn(blockId, dataset, sampleIdAxis, datasetGroupIdAxis)
				if !is_undefined(rules) {
					ds["dataset." + dataset.id + ".multiplexingRules"] = {
						spec: rules.spec,
						data: rules.data
					}
				}
			}

			if sampleGroupsColumnTypes[dataset.content.type] {
				sampleGroups := util.sampleGroupsColumn(blockId, dataset, sampleIdAxis, datasetGroupIdAxis)
				if !is_undefined(sampleGroups) {
					ds["dataset." + dataset.id + ".sampleGroups"] = sampleGroups
				}
			}

			for groupId, label in dataset.content.groupLabels {
				groupLabels[groupId] = label
			}

		} else {
			ds = proc.createDataset(blockId, sampleIdAxis, dataset, importFile)
		}
		for k, v in ds {
			exports.add(k, trace.inject(v.spec), v.data)
		}
	}

	// group labels column: one column for the groups of all grouped datasets
	if len(groupLabels) > 0 {
		exports.add("sampleGroupLabels", {
			kind: "PColumn",
			name: "pl7.app/label",
			valueType: "String",
			domain: {
				"pl7.app/block": blockId
			},
			annotations: {
				"pl7.app/label": "Sample Group",
				"pl7.app/isLabel": "true"
			},
			axesSpec: [groupIdAxis]
		}, util.createJsonPColumnData(groupLabels))
	}

	return {
		outputs: {
			fileImports: maps.mapValues(fileImports, func(im) {
				return im.handle
			}),
			// Collecting all imported file resources in the output ensures the
			// block's output tree is not finalized until all file uploads
			// complete. Without this, the block would report "Done" while files
			// are still uploading in the background, since im.handle alone
			// doesn't create a dependency on upload completion.
			uploadedFiles: maps.mapValues(fileImports, func(im) {
				return im.file
			})
		},
		exports: maps.merge({
			pf: exports.build()
		}, designExports)
	}
})
